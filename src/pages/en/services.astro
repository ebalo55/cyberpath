---
import Layout from "@layouts/Layout.astro";
import { ServicesHero } from "@/components/react/landing/services-hero";
import { ServicesSection } from "@/components/react/landing/services-section";
import { ReservationSection } from "@/components/react/landing/reservation-section";
import { makeJsonLd } from "@/lib/make-json-ld";
import type { WebSite } from "schema-dts";

const locale = "en";

const json_ld = makeJsonLd<WebSite>({
    "@type": "WebSite",
    "@context": "https://schema.org",
    "@id": "https://cyberpath-hq.com/en/services",
    url: "https://cyberpath-hq.com/en/services",
    name: "CyberPath - Services",
    description: "Our cybersecurity services: SOCaaS, penetration testing, security training, and secure backup solutions.",
    inLanguage: "en-US",
    author: {
        "@type": "Organization",
        name: "CyberPath",
        url: "https://cyberpath-hq.com",
    },
    publisher: {
        "@type": "Organization",
        name: "CyberPath",
    },
});
---

<Layout 
    JSON_LD={ json_ld } 
    seo={{ 
        title: "CyberPath Services | Cybersecurity Solutions for Business", 
        canonical: "https://cyberpath-hq.com/en/services", 
        description: "Explore our cybersecurity services: SOCaaS (Bastion), penetration testing, security awareness training, and secure backup. Enterprise-grade protection for your business.",
        openGraph: {
            title: "CyberPath - Services",
            description: "Cybersecurity services for businesses",
            type: "website",
            url: "https://cyberpath-hq.com/en/services",
        }
    }} 
    locale={locale}
>
    <ServicesHero client:load locale={locale} />
    <ServicesSection client:visible locale={locale} />
</Layout>