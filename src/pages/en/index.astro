---
import Layout from "@layouts/Layout.astro";
import { Hero } from "@/components/react/landing/hero";
import { CostComparison } from "@/components/react/landing/cost-comparison";
import { Plans } from "@/components/react/landing/plans";

const locale = "en";

const date = new Date();
const json_ld = {
    "@type":          "WebPage",
    "@context":       "https://schema.org",
    "@id":            "https://cyberpath-hq.com/en/",
    url:              "https://cyberpath-hq.com/en/",
    name:             "CyberPath - Bastion SOCaaS",
    description:      "Bastion: Enterprise-grade SOC as a Service for businesses. 24/7 security monitoring, threat detection, and incident response.",
    inLanguage:       "en-US",
    datePublished:    `${ date.getFullYear() }-${ date.getMonth() + 1 }-${ date.getDate() }`,
};
---

<Layout JSON_LD={ JSON.stringify(json_ld) } seo={ { title: "CyberPath - Bastion SOCaaS", canonical: "https://cyberpath-hq.com/en/", description: "Bastion: Enterprise-grade SOC for businesses." } } locale={locale}>
    <Hero client:load locale={locale} />
    <CostComparison client:visible locale={locale} />
    <Plans client:visible locale={locale} />
</Layout>