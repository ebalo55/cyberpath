---
const date = new Date();
const json_ld = {
    "@type":          "WebPage",
    "@context":       "https://schema.org",
    "@id":            "https://cyberpath-hq.com/",
    url:              "https://cyberpath-hq.com/",
    name:             "CyberPath - SOCaaS for Small Businesses",
    description:      "Bastion: Enterprise-grade SOC as a Service for small and medium businesses. 24/7 security monitoring, threat detection, and incident response.",
    inLanguage:       "en-US",
    datePublished:    `${ date.getFullYear() }-${ date.getMonth() + 1 }-${ date.getDate() }`,
};
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Redirecting...</title>
    <script is:inline>
        const lang = navigator.language || navigator.userLanguage || "en";
        const locale = lang.startsWith("it") ? "/it/" : "/en/";
        window.location.href.replace(locale);
    </script>
</head>
<body>
    <a href="/en/">English</a> | <a href="/it/">Italiano</a>
</body>
</html>