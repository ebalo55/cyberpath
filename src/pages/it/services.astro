---
import Layout from "@layouts/Layout.astro";
import { Hero } from "@/components/react/landing/hero";
import { VideoSection } from "@/components/react/landing/video-section";
import { SecuritySection } from "@/components/react/landing/security-section";
import { MonitoringSection } from "@/components/react/landing/monitoring-section";
import { ComparisonSection } from "@/components/react/landing/comparison-section";
import { Pricing } from "@/components/react/landing/pricing";
import { FAQSection } from "@/components/react/landing/faq-section";
import { ReservationSection } from "@/components/react/landing/reservation-section";

const locale = "it";

const date = new Date();
const json_ld = {
    "@type":          "WebPage",
    "@context":       "https://schema.org",
    "@id":            "https://cyberpath-hq.com/it/services",
    url:              "https://cyberpath-hq.com/it/services",
    name:             "CyberPath - Servizi",
    description:      "I nostri servizi di cybersecurity: SOCaaS, formazione, consulenza e altro.",
    inLanguage:       "it-IT",
    datePublished:    `${ date.getFullYear() }-${ date.getMonth() + 1 }-${ date.getDate() }`,
};
---

<Layout JSON_LD={ JSON.stringify(json_ld) } seo={ { title: "CyberPath - Servizi", canonical: "https://cyberpath-hq.com/it/services", description: "I nostri servizi di cybersecurity: SOCaaS, formazione, consulenza e altro." } } locale={locale}>
    <Hero client:load locale={locale} />
    <VideoSection client:visible locale={locale} />
    <SecuritySection client:visible locale={locale} />
    <MonitoringSection client:visible locale={locale} />
    <ComparisonSection client:visible locale={locale} />
    <Pricing client:visible locale={locale} />
    <FAQSection client:visible locale={locale} />
    <ReservationSection client:visible locale={locale} />
</Layout>