---
import logo from "@assets/logo.svg";
import OptimizedImage from "@/components/astro/common/OptimizedImage.astro";
import { translations } from "@/lib/i18n/translations";
import type { Locale } from "@/lib/i18n/translations";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale].nav;
---

<header class="z-50 relative bg-white/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between p-4 lg:px-8" aria-label="Global">
    <a href={`/${locale}/`} class="-m-1.5 p-1.5" title="CyberPath">
      <span class="sr-only"> CyberPath </span>
      <OptimizedImage src={logo} alt="CyberPath" class="h-8 w-auto" loading="eager" />
    </a>
    <div class="flex lg:hidden">
      <button
        type="button"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700"
        id="mobile-menu-open"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
    <div class="hidden lg:flex lg:gap-x-10 items-center">
      <a href={`/${locale}/`} class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition-colors">{t.home}</a>
      <a href={`/${locale}/#security`} class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition-colors">{t.security}</a>
      <a href={`/${locale}/#reservation`} class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition-colors">{t.contact}</a>
      <a href={`/${locale}/services`} class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition-colors">{t.services}</a>
      <a href="/blog" class="text-sm font-semibold leading-6 text-gray-900 hover:text-blue-600 transition-colors">{t.blog}</a>
    </div>
  </nav>
  <div class="hidden lg:hidden" role="dialog" aria-modal="true" id="mobile-menu">
    <div class="fixed inset-0 z-10"></div>
    <div class="h-dvh fixed inset-y-0 right-0 z-10 w-full overflow-y-auto bg-white px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
      <div class="flex items-center justify-between">
        <a href={`/${locale}/`} class="-m-1.5 p-1.5" title="CyberPath">
          <span class="sr-only"> CyberPath </span>
          <OptimizedImage src={logo} alt="CyberPath" class="h-8 w-auto" loading="eager" />
        </a>
        <button type="button" class="-m-2.5 rounded-md p-2.5 text-gray-700" id="mobile-menu-close">
          <span class="sr-only">Close menu</span>
          <svg class="h-6 w-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-gray-500/10">
          <div class="space-y-2 py-6">
            <a href="/blog" class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50">{t.blog}</a>
            <a href={`/${locale}/services`} class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50">{t.services}</a>
            <a href={`/${locale}/#security`} class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50">{t.security}</a>
            <a href={`/${locale}/#pricing`} class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50">{t.pricing}</a>
            <a href={`/${locale}/#reservation`} class="-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50">{t.contact}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
<script is:inline>
  if (!window.mobile) {
    window.mobile = { is_menu_open: false };
  }
  const mobile_menu = document.getElementById("mobile-menu");
  if (!mobile_menu) {
    console.error("Mobile menu element not found");
  }

  function toggleMobileMenu(open) {
    if (open) {
      mobile_menu.style.display = "block";
      mobile_menu.setAttribute("aria-hidden", "false");
      window.mobile = { is_menu_open: true };
    } else {
      mobile_menu.style.display = "none";
      mobile_menu.setAttribute("aria-hidden", "true");
      window.mobile = { is_menu_open: false };
    }
  }

  const mobile_menu_close = document.getElementById("mobile-menu-close");
  const mobile_menu_open = document.getElementById("mobile-menu-open");
  toggleMobileMenu(false);

  mobile_menu_close?.addEventListener("click", () => {
    toggleMobileMenu(false);
  });
  mobile_menu_open?.addEventListener("click", () => {
    toggleMobileMenu(true);
  });
</script>