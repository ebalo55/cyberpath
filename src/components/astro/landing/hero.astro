---
import { translations } from "@/lib/i18n/translations";

interface Props {
    locale: string;
}

const { locale } = Astro.props;
const t = translations[locale as keyof typeof translations];
const hero = t.hero;
---

<section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
        <div class="absolute top-20 left-10 w-72 h-72 bg-gradient-to-br from-blue-400/20 to-cyan-400/20 rounded-full blur-3xl animate-float"></div>
        <div class="absolute top-40 right-20 w-96 h-96 bg-gradient-to-br from-indigo-400/20 to-purple-400/20 rounded-full blur-3xl animate-float delay-300"></div>
        <div class="absolute bottom-20 left-1/3 w-80 h-80 bg-gradient-to-br from-violet-400/20 to-blue-400/20 rounded-full blur-3xl animate-float delay-500"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-medium text-blue-700">
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-500"></span>
                </span>
                {hero.subtitle}
            </div>

            <h1 class="text-5xl font-bold tracking-tight text-neutral-900 sm:text-7xl lg:text-8xl mb-6">
                {hero.title}
            </h1>

            <p class="mt-6 text-lg sm:text-xl leading-8 text-neutral-600 max-w-3xl mx-auto">
                {hero.description}
            </p>

            <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-x-6">
                <a href={`/${locale}/pricing`}
                   class="group rounded-2xl bg-neutral-900 px-8 py-4 text-base font-semibold text-white shadow-2xl hover:bg-neutral-800 transition-all duration-300 hover:scale-105 hover:shadow-xl"
                >
                    <span class="flex items-center gap-2">
                        {hero.cta.primary}
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </span>
                </a>
                <a href={`/${locale}/pricing`}
                   class="text-base font-semibold leading-6 text-neutral-900 hover:text-neutral-600 transition-colors duration-300 flex items-center gap-2 group"
                >
                    {hero.cta.secondary}
                    <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neutral-300 to-transparent"></div>
</section>